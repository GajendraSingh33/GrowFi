generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

enum IncomeFrequency {
  one_time @map("one-time")
  weekly
  monthly
  yearly
}

enum HabitFrequency {
  daily
  weekly
  monthly
}

enum HabitLogStatus {
  completed
  missed
}

enum SavingsGoalStatus {
  active
  completed
  abandoned
}

enum AssetType {
  savings
  investment
  property
  other
}

enum FeedbackStatus {
  open
  in_progress
  resolved
}

model User {
  userId       String    @id @default(uuid()) @map("user_id") @db.Uuid
  name         String    @db.VarChar(120)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(user)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamp(6)

  incomeSources     IncomeSource[]
  expenses          Expense[]
  expenseCategories ExpenseCategory[]
  habits            Habit[]
  savingsGoals      SavingsGoal[]
  assets            Asset[]
  netWorthSnapshots NetWorthSnapshot[]
  adminFeedback     AdminFeedback[]

  @@map("users")
}

model IncomeSource {
  incomeId     String          @id @default(uuid()) @map("income_id") @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  sourceName   String          @map("source_name") @db.VarChar(120)
  amount       Decimal         @db.Decimal(12, 2)
  frequency    IncomeFrequency
  receivedDate DateTime        @map("received_date") @db.Date
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("income_sources")
}

model ExpenseCategory {
  categoryId String    @id @default(uuid()) @map("category_id") @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  name       String    @db.VarChar(80)
  icon       String?   @db.VarChar(50)
  isDefault  Boolean   @default(true) @map("is_default")
  user       User?     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  expenses   Expense[]

  @@index([userId])
  @@map("expense_categories")
}

model Expense {
  expenseId   String   @id @default(uuid()) @map("expense_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  amount      Decimal  @db.Decimal(12, 2)
  description String?  @db.VarChar(255)
  expenseDate DateTime @map("expense_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user     User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [categoryId])

  @@index([userId, expenseDate])
  @@map("expenses")
}

model Habit {
  habitId     String         @id @default(uuid()) @map("habit_id") @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  name        String         @db.VarChar(120)
  frequency   HabitFrequency
  targetValue Decimal?       @map("target_value") @db.Decimal(12, 2)
  startDate   DateTime       @map("start_date") @db.Date
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)

  user User       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  logs HabitLog[]

  @@map("habits")
}

model HabitLog {
  logId       String         @id @default(uuid()) @map("log_id") @db.Uuid
  habitId     String         @map("habit_id") @db.Uuid
  logDate     DateTime       @map("log_date") @db.Date
  status      HabitLogStatus
  /// Computed and maintained server-side from this habit's log history; never trust client input.
  streakCount Int            @map("streak_count")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamp(6)

  habit Habit @relation(fields: [habitId], references: [habitId], onDelete: Cascade)

  @@unique([habitId, logDate])
  @@map("habit_logs")
}

model SavingsGoal {
  goalId        String            @id @default(uuid()) @map("goal_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  goalName      String            @map("goal_name") @db.VarChar(120)
  targetAmount  Decimal           @map("target_amount") @db.Decimal(12, 2)
  currentAmount Decimal           @default(0) @map("current_amount") @db.Decimal(12, 2)
  targetDate    DateTime?         @map("target_date") @db.Date
  status        SavingsGoalStatus @default(active)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, status])
  @@map("savings_goals")
}

model Asset {
  assetId      String    @id @default(uuid()) @map("asset_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  assetType    AssetType @map("asset_type")
  assetName    String    @map("asset_name") @db.VarChar(120)
  currentValue Decimal   @map("current_value") @db.Decimal(14, 2)
  lastUpdated  DateTime  @map("last_updated") @db.Date
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("assets")
}

model NetWorthSnapshot {
  snapshotId       String   @id @default(uuid()) @map("snapshot_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  snapshotDate     DateTime @map("snapshot_date") @db.Date
  totalAssets      Decimal  @map("total_assets") @db.Decimal(14, 2)
  totalSavings     Decimal  @map("total_savings") @db.Decimal(14, 2)
  totalInvestments Decimal  @map("total_investments") @db.Decimal(14, 2)
  /// Computed server-side from the snapshot inputs; never accept a client-supplied value.
  netWorth         Decimal  @map("net_worth") @db.Decimal(14, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, snapshotDate])
  @@map("net_worth_snapshots")
}

model AdminFeedback {
  feedbackId String         @id @default(uuid()) @map("feedback_id") @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  subject    String         @db.VarChar(150)
  message    String
  status     FeedbackStatus @default(open)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamp(6)

  // Retain feedback when a user is soft-deleted; do not cascade this relation.
  user User @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@map("admin_feedback")
}
